rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/chatRooms/$(roomId);
    }

    function isMember(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && request.auth.uid in get(roomPath(roomId)).data.members;
    }

    function validInvite(roomId, token) {
      return token is string
        && exists(/databases/$(database)/documents/chatRooms/$(roomId)/invites/$(token))
        && get(/databases/$(database)/documents/chatRooms/$(roomId)/invites/$(token)).data.roomId == roomId
        && get(/databases/$(database)/documents/chatRooms/$(roomId)/invites/$(token)).data.active == true
        && get(roomPath(roomId)).data.inviteEnabled == true;
    }

    match /chatRooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.inviteEnabled == true
        && request.resource.data.code is string
        && request.resource.data.name is string;

      allow get, list: if isMember(roomId);

      allow update: if signedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt', 'inviteEnabled'])
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members is list
          && request.resource.data.members.hasAll(resource.data.members) == false
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        )
        || (
          !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && exists(/databases/$(database)/documents/chatRooms/$(roomId)/joinRequests/$(request.auth.uid))
          && get(/databases/$(database)/documents/chatRooms/$(roomId)/joinRequests/$(request.auth.uid)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/chatRooms/$(roomId)/joinRequests/$(request.auth.uid)).data.roomId == roomId
          && validInvite(roomId, get(/databases/$(database)/documents/chatRooms/$(roomId)/joinRequests/$(request.auth.uid)).data.inviteToken)
        )
        || (
          request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.ownerUid
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /invites/{token} {
        allow get: if signedIn();
        allow list: if false;
        allow create: if signedIn()
          && get(roomPath(roomId)).data.ownerUid == request.auth.uid
          && request.resource.data.roomId == roomId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.roomName is string;
        allow update: if signedIn()
          && get(roomPath(roomId)).data.ownerUid == request.auth.uid
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
        allow delete: if signedIn() && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
      }

      match /joinRequests/{uid} {
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.roomId == roomId
          && validInvite(roomId, request.resource.data.inviteToken);
        allow get, delete: if signedIn() && request.auth.uid == uid;
        allow list, update: if false;
      }

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.name is string;
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
